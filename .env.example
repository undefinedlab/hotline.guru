# Hotline.guru local env
DATABASE_PATH=./data/hotline.db
PORT=8787
AGI_PORT=4573

# Arc
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Wallet mode: local (EOAs via viem) | circle (developer-controlled — needs API keys)
WALLET_MODE=local
# Optional encrypt salt for local private keys at rest
WALLET_SECRET=dev-only-change-me

# Operator agent wallet (Circle CLI) — faucet target / optional top-up
OPERATOR_ARC_ADDRESS=0x161102d980f44ad03fb532730d6cad8fb3857de5
# Lab treasury EOA (auto-created in data/lab-wallets.json) — demo sink we control
# LAB_WALLETS_PATH=./data/lab-wallets.json
# CIRCLE_API_KEY=   # enables auto faucet drips when funds run low

# Circle developer-controlled wallets (optional)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=

# SMS provider: mock | telnyx | africas_talking
SMS_PROVIDER=mock
# TELNYX_API_KEY=
# TELNYX_FROM=
# AT_USERNAME=
# AT_API_KEY=
# AT_FROM=

# Intent: rule (default, no API key) | openai
INTENT_MODE=rule
# OPENAI_API_KEY=

# Policy defaults (USDC)
POLICY_PER_TX_CAP=10
POLICY_DAILY_CAP=50
POLICY_NANOPAY_DAILY=1

# STT (faster-whisper) — docker compose in telephony/
STT_URL=http://127.0.0.1:8090
SHARED_DIR=./telephony/shared
ASTERISK_SHARED=/shared
# WHISPER_MODEL=tiny.en

# Demo UX: one utterance sends under policy (set 0 for PIN confirm dance)
DEMO_SIMPLE=1
DEMO_PIN=1234

# Marketplace price endpoint
PRICE_SERVICE_URL=https://api.aisa.one/apis/v2/coingecko/simple/price
# Set to 1 after funding Circle Gateway on BASE (or MARKETPLACE_PAY_CHAIN)
# MARKETPLACE_LIVE=0
# MARKETPLACE_PAY_CHAIN=BASE
# FRAUD_CHECK_ON_JOIN=0
