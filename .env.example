# Hotline.guru local env
HOTLINE_PROFILE=lab
DATABASE_PATH=./data/hotline.db
# Docker pack uses Postgres automatically (DATABASE_URL set in compose)
# DATABASE_URL=postgres://hotline:hotline@localhost:5432/hotline
PORT=8787
AGI_PORT=4573

# Arc Testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Money path: Circle DCW is default (SCA + Gas Station on Arc testnet)
# Soft-falls removed: missing CIRCLE_* with WALLET_MODE=circle refuses to boot.
# Use WALLET_MODE=local or lab-only ALLOW_LOCAL_FALLBACK=1. Tests use WALLET_MODE=local.
WALLET_MODE=circle
WALLET_SECRET=dev-only-change-me

# Operator / lab funding (local mode only)
OPERATOR_ARC_ADDRESS=0x161102d980f44ad03fb532730d6cad8fb3857de5
# LAB_WALLETS_PATH=./data/lab-wallets.json

# Circle developer-controlled wallets (default money path)
# 1) CIRCLE_API_KEY from console
# 2) npm run circle:register-secret   → writes CIRCLE_ENTITY_SECRET + ./recovery/
# 3) Create wallet set in console → CIRCLE_WALLET_SET_ID
# 4) npm run circle:smoke
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_ACCOUNT_TYPE=SCA
CIRCLE_GAS_STATION=1
# CIRCLE_FEE_LEVEL=MEDIUM
# CIRCLE_TX_POLL_MAX=40
# ALLOW_LOCAL_FALLBACK=0        # never silent Circle→local; lab-only if set to 1
# ESCROW_ACCOUNT=+10000000000
# PENDING_CLAIM_DAYS=7
# PENDING_CLAIM_DAILY_CAP=20
# SIM_COOLDOWN_HOURS=24
# SIM_COOLDOWN_MAX_SEND=1
# CALLBACK_THRESHOLD_USDC=5
# CALLBACK_VERIFY_MINUTES=20
# ASYNC_SETTLE=0                # 1 = ack now, settle in background (voice-friendly)
# AUDIT_EXPORT_TOKEN=           # Bearer token for GET /v1/audit/policy (required in staging)
# X402_LAB_FREE=0
# X402_OPS_ACCOUNT=+10000000000
# X402_PAYMENT_SECRET=
# X402_PRICE_DELIVER=0.01
# X402_PRICE_CALL=0.55
# X402_PRICE_RESEARCH=0.03
# X402_MAX_CALL=0.60
# X402_MAX_PROXY=0.50
# X402_PROXY_ALLOW=          # extra comma-separated hosts
# X402_PRICE_SHOP=0.01
# X402_PRICE_BUY=0.01
# X402_MAX_SHOP=0.05
# SHOP_STORE_URL=https://shop.circle.com
# OUTBOUND_CALL_URL=https://stablephone.dev/api/call
# MARKETPLACE_LIVE=0         # 1 = circle services pay for price/fraud/call/research/shopping
# MARKETPLACE_PAY_CHAIN=BASE
# STANDING_PIN=                 # optional PIN for npm run standing worker


# SMS provider: mock | telnyx | africas_talking
# Staging: WEBHOOK_VERIFY=1 + provider secrets required
SMS_PROVIDER=mock
# WEBHOOK_VERIFY=0
# RATE_LIMIT_PER_MIN=30

# Inbound voice trunk — set these, then `npm run trunk` writes telephony/asterisk/pjsip.conf
# INBOUND_DID=+15551234567
# SIP_TRUNK_HOST=sip.telnyx.com   # Telnyx: sip.telnyx.com · Zadarma: pbx.zadarma.com
# SIP_USER=
# SIP_PASSWORD=
# PUBLIC_IP=                      # public IPv4 of the Asterisk host — omit and audio is one-way
# SOFTPHONE_PASSWORD=             # change from hotline-lab on any public host

# TELNYX_API_KEY=
# TELNYX_FROM=
# TELNYX_PUBLIC_KEY=          # ed25519 public key from Telnyx portal (preferred)
# TELNYX_WEBHOOK_SECRET=     # lab HMAC fallback
# SMS_WEBHOOK_SECRET=
# AT_USERNAME=
# AT_API_KEY=
# AT_FROM=
# AT_WEBHOOK_SECRET=         # header X-AT-Secret or ?secret=

# Staging profile — refuses weak secrets on boot
# HOTLINE_PROFILE=staging
# WEBHOOK_VERIFY=1
# AUDIT_EXPORT_TOKEN=
# DATABASE_URL=postgres://hotline:hotline@localhost:5432/hotline
# SIM_ATTEST_MODE=off
# DEMO_SIMPLE=0
# LAB_HTTP_API=0
# LAB_API_TOKEN=                 # required if LAB_HTTP_API=1
# AGI_BIND=127.0.0.1             # host mode; compose keeps AGI internal
# NID_PEPPER=                    # national-id hash pepper (defaults to WALLET_SECRET)
# Backup: npm run backup  (or BACKUP_DIR=./data/backups)

# WhatsApp Cloud API (Meta) — GET/POST /webhooks/whatsapp
WHATSAPP_PROVIDER=mock
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=hotline-verify
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# MIRROR_CHAT_TO_SMS=0

# Telegram Bot — POST /webhooks/telegram
TELEGRAM_PROVIDER=mock
# TELEGRAM_PROVIDER=bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Intent: rule | openai
INTENT_MODE=rule
# OPENAI_API_KEY=

# Policy (USDC) — base caps; tier multipliers via POLICY_T0_* / T1_* / T2_*
POLICY_PER_TX_CAP=10
POLICY_DAILY_CAP=50
POLICY_NANOPAY_DAILY=1
# POLICY_T0_PER_TX=5
# POLICY_T0_DAILY=20
# POLICY_T1_PER_TX=25
# POLICY_T1_DAILY=100
# POLICY_T2_PER_TX=100
# POLICY_T2_DAILY=500
# SIM attest: mock (lab) | live (fraud lookup) | off
SIM_ATTEST_MODE=mock
PIN_MAX_FAILS=5
PIN_LOCK_MINUTES=15

# STT
STT_URL=http://127.0.0.1:8090
SHARED_DIR=./telephony/shared
ASTERISK_SHARED=/shared
# WHISPER_MODEL=tiny.en

# Demo: DEMO_SIMPLE=1 skips PIN confirm
DEMO_SIMPLE=0
DEMO_PIN=1234

# Marketplace / x402
PRICE_SERVICE_URL=https://api.aisa.one/apis/v2/coingecko/simple/price
# MARKETPLACE_LIVE=0
# MARKETPLACE_PAY_CHAIN=BASE
# FRAUD_CHECK_ON_JOIN=0
