# Hotline.guru local env
HOTLINE_PROFILE=lab
DATABASE_PATH=./data/hotline.db
# Docker pack uses Postgres automatically (DATABASE_URL set in compose)
# DATABASE_URL=postgres://hotline:hotline@localhost:5432/hotline
PORT=8787
AGI_PORT=4573

# Arc Testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Money path: Circle DCW is default (SCA + Gas Station on Arc testnet)
# Soft-falls back to local EOAs if CIRCLE_* missing. Tests use WALLET_MODE=local.
WALLET_MODE=circle
WALLET_SECRET=dev-only-change-me

# Operator / lab funding (local mode only)
OPERATOR_ARC_ADDRESS=0x161102d980f44ad03fb532730d6cad8fb3857de5
# LAB_WALLETS_PATH=./data/lab-wallets.json

# Circle developer-controlled wallets (default money path)
# 1) CIRCLE_API_KEY from console
# 2) npm run circle:register-secret   → writes CIRCLE_ENTITY_SECRET + ./recovery/
# 3) Create wallet set in console → CIRCLE_WALLET_SET_ID
# 4) npm run circle:smoke
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_ACCOUNT_TYPE=SCA
CIRCLE_GAS_STATION=1
# CIRCLE_FEE_LEVEL=MEDIUM
# CIRCLE_TX_POLL_MAX=40
# AUDIT_EXPORT_TOKEN=           # Bearer token for GET /v1/audit/policy (required in staging)

# SMS provider: mock | telnyx | africas_talking
# Staging: WEBHOOK_VERIFY=1 + provider secrets required
SMS_PROVIDER=mock
# WEBHOOK_VERIFY=0
# RATE_LIMIT_PER_MIN=30
# INBOUND_DID=+15551234567
# SIP_TRUNK_HOST=sip.telnyx.com
# TELNYX_API_KEY=
# TELNYX_FROM=
# TELNYX_PUBLIC_KEY=          # ed25519 public key from Telnyx portal (preferred)
# TELNYX_WEBHOOK_SECRET=     # lab HMAC fallback
# SMS_WEBHOOK_SECRET=
# AT_USERNAME=
# AT_API_KEY=
# AT_FROM=
# AT_WEBHOOK_SECRET=         # header X-AT-Secret or ?secret=

# Staging profile — refuses weak secrets on boot
# HOTLINE_PROFILE=staging
# WEBHOOK_VERIFY=1
# AUDIT_EXPORT_TOKEN=
# DATABASE_URL=postgres://hotline:hotline@localhost:5432/hotline
# Backup: npm run backup  (or BACKUP_DIR=./data/backups)

# WhatsApp Cloud API (Meta) — GET/POST /webhooks/whatsapp
WHATSAPP_PROVIDER=mock
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=hotline-verify
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# MIRROR_CHAT_TO_SMS=0

# Telegram Bot — POST /webhooks/telegram
TELEGRAM_PROVIDER=mock
# TELEGRAM_PROVIDER=bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Intent: rule | openai
INTENT_MODE=rule
# OPENAI_API_KEY=

# Policy (USDC) — base caps; tier multipliers via POLICY_T0_* / T1_* / T2_*
POLICY_PER_TX_CAP=10
POLICY_DAILY_CAP=50
POLICY_NANOPAY_DAILY=1
# POLICY_T0_PER_TX=5
# POLICY_T0_DAILY=20
# POLICY_T1_PER_TX=25
# POLICY_T1_DAILY=100
# POLICY_T2_PER_TX=100
# POLICY_T2_DAILY=500
# SIM attest: mock (lab) | live (fraud lookup) | off
SIM_ATTEST_MODE=mock
PIN_MAX_FAILS=5
PIN_LOCK_MINUTES=15

# STT
STT_URL=http://127.0.0.1:8090
SHARED_DIR=./telephony/shared
ASTERISK_SHARED=/shared
# WHISPER_MODEL=tiny.en

# Demo: DEMO_SIMPLE=1 skips PIN confirm
DEMO_SIMPLE=0
DEMO_PIN=1234

# Marketplace / x402
PRICE_SERVICE_URL=https://api.aisa.one/apis/v2/coingecko/simple/price
# MARKETPLACE_LIVE=0
# MARKETPLACE_PAY_CHAIN=BASE
# FRAUD_CHECK_ON_JOIN=0
