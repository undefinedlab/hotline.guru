# Hotline.guru local env
HOTLINE_PROFILE=lab
DATABASE_PATH=./data/hotline.db
# DATABASE_URL=postgres://hotline:hotline@localhost:5432/hotline
PORT=8787
AGI_PORT=4573

# Arc Testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER=https://testnet.arcscan.app
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# Wallet mode: local (viem EOAs) | circle (Circle DCW on Arc)
WALLET_MODE=local
WALLET_SECRET=dev-only-change-me

# Operator / lab funding (local mode)
OPERATOR_ARC_ADDRESS=0x161102d980f44ad03fb532730d6cad8fb3857de5
# LAB_WALLETS_PATH=./data/lab-wallets.json

# Circle developer-controlled wallets (WALLET_MODE=circle)
# 1) CIRCLE_API_KEY from console
# 2) npm run circle:register-secret   → writes CIRCLE_ENTITY_SECRET + ./recovery/
# 3) Create wallet set in console → CIRCLE_WALLET_SET_ID
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
# CIRCLE_ACCOUNT_TYPE=EOA
# CIRCLE_GAS_STATION=1          # creates SCA wallets; Arc testnet Gas Station sponsors fees
# CIRCLE_FEE_LEVEL=MEDIUM
# CIRCLE_TX_POLL_MAX=40
# AUDIT_EXPORT_TOKEN=           # Bearer token for GET /v1/audit/policy (required in staging)

# SMS provider: mock | telnyx | africas_talking
SMS_PROVIDER=mock
# WEBHOOK_VERIFY=0
# TELNYX_API_KEY=
# TELNYX_FROM=
# TELNYX_WEBHOOK_SECRET=
# SMS_WEBHOOK_SECRET=
# AT_USERNAME=
# AT_API_KEY=
# AT_FROM=

# Intent: rule | openai
INTENT_MODE=rule
# OPENAI_API_KEY=

# Policy (USDC)
POLICY_PER_TX_CAP=10
POLICY_DAILY_CAP=50
POLICY_NANOPAY_DAILY=1
PIN_MAX_FAILS=5
PIN_LOCK_MINUTES=15

# STT
STT_URL=http://127.0.0.1:8090
SHARED_DIR=./telephony/shared
ASTERISK_SHARED=/shared
# WHISPER_MODEL=tiny.en

# Demo: DEMO_SIMPLE=1 skips PIN confirm
DEMO_SIMPLE=0
DEMO_PIN=1234

# Marketplace / x402
PRICE_SERVICE_URL=https://api.aisa.one/apis/v2/coingecko/simple/price
# MARKETPLACE_LIVE=0
# MARKETPLACE_PAY_CHAIN=BASE
# FRAUD_CHECK_ON_JOIN=0
